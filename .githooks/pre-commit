#!/bin/sh
# =====================================================================
#  コミット前フック
#  (1) 翻訳の確認（tools/check-lang.js）。問題があればコミットを止める
#      コメントや index.html の日本語のずれは node tools/check-lang.js --fix で直せる
#  (2) Web 版（GitHub Pages）のキャッシュ対策のバージョン番号を書き換える
#   ・index.html の js / css の読み込みに付けた ?v=… と <meta name="game-version">
#     → 新しい index.html を読めば、全ファイルが新しい版でそろって読み込まれる
#   ・version.json → ゲームが起動時・ガレージ表示時に読み、新しい版があればお知らせを出す
#  GitHub Pages は全ファイルを max-age=600（10分）で配信し、ヘッダーは変更できないための対策
#  有効化（クローンごとに1回）：git config core.hooksPath .githooks
# =====================================================================
set -e
cd "$(git rev-parse --show-toplevel)"
if command -v node >/dev/null 2>&1; then
  if ! node tools/check-lang.js; then
    echo "コミットを中止しました（翻訳の確認）。コメント・index.html の写しのずれは node tools/check-lang.js --fix で直せます" >&2
    exit 1
  fi
else
  echo "（node が見つからないため、翻訳の確認を省略しました）" >&2
fi
v=$(date +%Y%m%d-%H%M%S)
sed -i -E "s/\?v=[A-Za-z0-9-]+\"/?v=$v\"/g; s/(<meta name=\"game-version\" content=\")[^\"]*/\1$v/" index.html
printf '{ "version": "%s" }\n' "$v" > version.json
git add index.html version.json
